+    const request = {
+      setTimeout() {},
+      once(event, listener) {
+        listeners[event] = listener;
+        return request;
+      },
+      destroy(error) {
+        if (listeners.error) listeners.error(error);
+      },
+      end() {
+        onResponse({
+          statusCode: 200,
+          headers: {},
