+function redactSensitiveText(value) {
+  let text = String(value == null ? '' : value).normalize('NFKC');
+  text = text.replace(/-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----[\s\S]*?-----END [A-Z0-9 ]*PRIVATE KEY-----/gi, '[REDACTED]');
