+
+function classifyCurrentCrm(db, options = {}) {
+  const normalized = readEligibleCrmRecords(db);
+  const counts = {
+    input: normalized.records.length,
+    excluded_domestic: normalized.excluded_domestic_ids.length,
+    test: 0,
+    noise: 0,
+    needs_review: 0,
+    valid: 0,
+    errors: 0
+  };
