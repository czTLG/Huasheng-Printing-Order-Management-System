+    action: 'read_matrix_candidate_detail',
+    resourceType: 'matrix_candidate',
+    resourceId: id
+  });
+  res.json({
+    ...safeCandidate(row, evidence.map(item => item.source_url)),
+    evidence
+  });
+});
