+  CREATE TABLE inquiries (id INTEGER PRIMARY KEY, customer_id INTEGER, created_at TEXT);
+  CREATE TABLE orders (id INTEGER PRIMARY KEY, customer_name TEXT NOT NULL, created_at TEXT);
