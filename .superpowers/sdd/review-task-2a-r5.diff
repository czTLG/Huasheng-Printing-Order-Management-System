+        let dkim = [];
+        let dmarc = [];
+        let transport = { tls: false, smtp: false };
+        try {
+          [spf, dkim, dmarc] = await Promise.all([
+            resolveTxt(domain),
+            selector ? resolveTxt(`${selector}._domainkey.${domain}`) : Promise.resolve([]),
